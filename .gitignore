# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments and package metadata
.venv/
venv/
env/
.uv-cache/
*.egg-info/
build/
dist/

# Editors, operating systems, and local tooling
.vscode/
.idea/
.DS_Store
Thumbs.db
.qodo/
.agents/
.docx_review/

# Datasets and generated experiment artifacts are versioned through Git LFS.
# See .gitattributes for the LFS-managed paths.
datasets/**/__MACOSX/
datasets/**/*.DS_Store

# Notebook-generated checkpoints
.ipynb_checkpoints/

# Local secrets and environment overrides
.env
.env.*
!.env.example
